# Copy this file to .env and replace placeholders yourself.
# Agents and automation must never read or modify the resulting .env file.

APP_ENV=development
LOG_LEVEL=INFO

LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-provider-model-id
LLM_HTTP_PROXY_URL=
LLM_TIMEOUT_SECONDS=60

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BACKEND_PORT=8000
FRONTEND_PORT=8080

# Optional only when Windows Compose talks to a WSL Docker Engine over TCP/socat.
HOST_PROJECT_PATH=

